FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Tell uv to install into the system Python (replaces deprecated --system flag)
ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

# Copy dependency manifest first for layer caching
COPY pyproject.toml .

# Sync dependencies (no dev deps)
RUN uv sync --no-dev

# Copy web package
COPY web/ ./web/

EXPOSE 5000

CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5000", "web.app:app"]
