# Pocket-ID OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=

# JWT Role
OIDC_ADMIN_GROUP=admin

# Flask
SECRET_KEY=
BASE_URL=
# Set to false only for plain-http local dev (default: true).
SESSION_COOKIE_SECURE=true

# Redis
REDIS_URL=redis://redis:6379/0

# Storage
JOBS_DIR=/jobs
MAX_UPLOAD_MB=500

# Google Cloud Document AI
# Auth: mount a service-account JSON key and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# Worker
# Number of concurrent Celery task processes. OCR is now network-bound
# (one Document AI call per page), so higher values are safe.
WORKER_CONCURRENCY=4
